# Auto detect text files and perform LF normalization
* text=auto

# Fins de ligne LF dans la copie de travail (cohérence Windows / Linux CI et Biome).
*.ts            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
*.sql           text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.dev.vars.example text eol=lf
CODEOWNERS      text eol=lf
LICENSE         text eol=lf
NOTICE          text eol=lf
