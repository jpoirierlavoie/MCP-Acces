{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acces",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "acces.poirierlavoie.ca",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB_IDENTITE",
      "database_name": "mcp-identite",
      "database_id": "ee4894cc-a779-466b-bc9b-ac157b354afc",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "COURRIEL"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_DEMANDE_IP",
      "namespace_id": "1031",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_OAUTH_IP",
      "namespace_id": "1032",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["23 7 * * *"]
  },
  "vars": {
    "MCP_ENABLED": "true",
    "MODE_ADMISSION": "invitation",
    "ORIGINE_PORTAIL": "https://acces.poirierlavoie.ca",
    "EXPEDITEUR_COURRIEL": "noreply@acces.poirierlavoie.ca",
    "CANLII_BASE_URL": "https://api.canlii.org/v1",
    "COMMIT": "inconnu",
    "ALLOWED_ORIGINS": ""
  }
}
