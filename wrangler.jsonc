{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acces",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Domaine personnalisé (zone poirierlavoie.ca) : Cloudflare gère DNS + certificat.
  "routes": [{ "pattern": "acces.poirierlavoie.ca", "custom_domain": true }],
  "workers_dev": false,

  // Zéro journalisation d'invocation ou d'URL porteuse de jeton de lien/code (SPEC §7.3, G37).
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },

  // Base D1 partagée d'identité et de gouverne (`mcp-identite`), liée sous `DB_IDENTITE`
  // à `MCP-Acces`, `MCP-Legislation` et `MCP-Jurisprudence` (SPEC §4.1).
  // Avant le premier déploiement distant, remplacer `database_id` par l'UUID retourné par :
  //   npx wrangler d1 create mcp-identite --location enam
  "d1_databases": [
    {
      "binding": "DB_IDENTITE",
      "database_name": "mcp-identite",
      "database_id": "ee4894cc-a779-466b-bc9b-ac157b354afc",
      "migrations_dir": "migrations"
    }
  ],

  // Liaison native Cloudflare Email Sending (zéro clé API externe, expéditeur noreply@acces.poirierlavoie.ca).
  "send_email": [
    {
      "name": "COURRIEL"
    }
  ],

  // Limiteurs d'arête à `namespace_id` distincts de Législation (1011..1015) et Jurisprudence (1021..1025) (G34).
  "ratelimits": [
    {
      "name": "RL_DEMANDE_IP",
      "namespace_id": "1031",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_OAUTH_IP",
      "namespace_id": "1032",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // Purge quotidienne indexée Loi 25 (`purgerRetentionsD1`, SPEC §7.2, G16).
  "triggers": { "crons": ["23 7 * * *"] },

  "vars": {
    // Coupe-circuit global (polarité fermée par défaut : !== "true" => coupe /oauth/*, /demande*, /moi*, /health,
    // tout en laissant publiques GET / et les 5 pages de gouvernance, G22).
    "MCP_ENABLED": "true",
    // Mode d'ouverture de /demande : "ferme" (défaut si absent), "invitation" ou "ouvert" (SPEC §4.3).
    "MODE_ADMISSION": "invitation",
    "ORIGINE_PORTAIL": "https://acces.poirierlavoie.ca",
    "EXPEDITEUR_COURRIEL": "noreply@acces.poirierlavoie.ca",
    "CANLII_BASE_URL": "https://api.canlii.org/v1",
    "COMMIT": "inconnu",
    "ALLOWED_ORIGINS": "https://chatgpt.com,https://chat.openai.com,https://platform.openai.com"
  }
}
