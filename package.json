{
  "name": "mcp-acces",
  "version": "1.0.1",
  "private": true,
  "description": "Portail d'admission Barreau du Québec, coffre BYOK CanLII, console libre-service (/moi), console d'exploitation (/exploitant) et serveur d'autorisation OAuth 2.1 (acces.poirierlavoie.ca).",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "node scripts/deployer.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/verifier-audit.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mcp-identite --local",
    "db:migrate:remote": "wrangler d1 migrations apply mcp-identite --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@poirierlavoie/mcp-socle": "github:jpoirierlavoie/MCP-Socle#v0.8.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  }
}
